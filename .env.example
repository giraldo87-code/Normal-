# ===== DATABASE =====
DATABASE_URL=postgresql://monitor_user:monitor_secure_pass@postgres:5432/monitor_db

# ===== ENVIRONMENT =====
ENVIRONMENT=development
DEBUG=true

# ===== API =====
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ===== REDIS =====
REDIS_URL=redis://redis:6379

# ===== JWT =====
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===== FRONTEND =====
REACT_APP_API_URL=http://localhost:8000

# ===== LOGGING =====
LOG_LEVEL=INFO

# ===== ALERTAS =====
ALERT_ENABLED=true
ALERT_EMAIL_ENABLED=false
ALERT_SMS_ENABLED=false